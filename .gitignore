# Environnement et outils
.venv/
.python/
.uv-cache/
.pytest-tmp/
.pytest-tmp*/
.tmp/
.idea/
.vscode/
.DS_Store
.pytest_cache/
.mypy_cache/
.ruff_cache/
.mplconfig/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.env
.env.*
!.env.example

.local/

# Données CIFAR-10 : téléchargées automatiquement au premier lancement
data/*
!data/.gitkeep

# Poids des modèles (44 Mo pour ResNet-18) : à régénérer avec les commandes du README.
# Les summary.json et history.csv restent versionnés pour tracer les expériences.
*.pt
*.pth
!artifacts/final_model.pt
!artifacts/final_model.json

# Logs TensorBoard
runs/

# Fichiers temporaires de génération ; le PDF final est dans report/.
output/

# Ne conserver que les historiques et résumés des expériences.
checkpoints/*
!checkpoints/README.md
!checkpoints/*/
checkpoints/*/*
!checkpoints/*/history.csv
!checkpoints/*/summary.json

# Livrable final uniquement ; les poids intermédiaires restent locaux.
artifacts/*
!artifacts/final_model.pt
!artifacts/final_model.json

# Nouveaux journaux locaux. Les deux journaux historiques déjà suivis restent
# conservés, notamment pour scripts/finish_resnet18.py.
logs/*
